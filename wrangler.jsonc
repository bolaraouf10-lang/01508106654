{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "street-racing-room-server",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomServer"
      }
    ]
  },
  "exports": {
    "RoomServer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
